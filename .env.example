# Copy to .env and fill in. Never commit .env.

PORT=8787
# Relative paths are resolved from the repository root.
DATABASE_PATH=data/app.db
# Origin the browser uses for the app (Vite dev server in development).
APP_ORIGIN=http://localhost:5173
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# Have the app terminate HTTPS itself instead of plain HTTP (e.g. a self-signed cert for LAN-only
# access with no reverse proxy in front) — both or neither. Browser APIs the app relies on
# (crypto.randomUUID, Secure cookies) require a real secure context, so plain HTTP only works for
# http://localhost. See README "HTTPS without a domain" for how to generate the cert.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Used only by docker-compose.yml on the server (Traefik routing), not read by the app itself.
# Bare domain for the Traefik Host(...) rule, e.g. video.example.com
APP_DOMAIN=
# 10 GiB
MAX_UPLOAD_BYTES=10737418240

# S3-compatible object storage. Cloudflare R2 with EU jurisdiction:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style URLs (endpoint/bucket/key) work on R2, Hetzner and MinIO alike.
S3_FORCE_PATH_STYLE=true
