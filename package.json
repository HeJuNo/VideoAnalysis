{
  "name": "sport-video-analysis",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "node --test \"shared/test/*.test.ts\" \"server/test/*.test.ts\"",
    "typecheck": "tsc -p server && tsc -p web",
    "user:create": "npm run user:create -w server --",
    "storage:setup": "npm run storage:setup -w server"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
